@startuml
left to right direction
skinparam shadowing false
hide empty members
hide methods
hide attributes

' ==========================================
' External Frameworks & Libraries
' ==========================================
package "External_Libraries" {
    interface MongoRepository <<Spring>>
    class OkHttpClient <<OkHttp>>
    class VerticalLayout <<Vaadin>>
    class AppLayout <<Vaadin>>
    class Dialog <<Vaadin>>
    class Button <<Vaadin>>
}

' ==========================================
' Configurations
' ==========================================
package "Configurations" {
    class AppMain
    class AppConfig
    class SecurityConfig
}

' ==========================================
' Data Models
' ==========================================
package "Data_Models" {
    class User
    class Message
    class Files
}

' ==========================================
' Repositories (Data Access)
' ==========================================
package "Repositories" {
    interface UserRepository
    interface MessageRepository
    interface FilesRepository
}

' ==========================================
' Services (Business Logic)
' ==========================================
package "Services" {
    class UserService
    class MessageService
    class HistoryService
    class StgnoService
    class F5StegoService
    class DSSSStegnoService
    class PVDStegoService
    class ConvertService
}

' ==========================================
' Utilities & Algorithms
' ==========================================
package "Utilities" {
    class DsssUtils
    class F5Utility
    class PvdUtils
    
    ' איחוד התיקייה כרכיב ספרייה סגור ומבודד ללא פירוט פנימי
    package "QDCT" #LightGray {
    }
}

' ==========================================
' UI (Views & Components)
' ==========================================
package "UI_Views" {
    class MainLayout
    class HomeView
    class LoginView
    class RegisterView
    class StgnoView
    class InboxView
    class SentMessagesView
    class HistoryView
    class NewMessageDialog
    class MediaPreviewButton
}

' ==========================================
' Relationships: Inheritance
' ==========================================
MongoRepository <|-- UserRepository
MongoRepository <|-- MessageRepository
MongoRepository <|-- FilesRepository

AppLayout <|-- MainLayout
VerticalLayout <|-- HomeView
VerticalLayout <|-- LoginView
VerticalLayout <|-- RegisterView
VerticalLayout <|-- StgnoView
VerticalLayout <|-- InboxView
VerticalLayout <|-- SentMessagesView
VerticalLayout <|-- HistoryView
Dialog <|-- NewMessageDialog
Button <|-- MediaPreviewButton

' ==========================================
' Relationships: Configurations
' ==========================================
SecurityConfig --> UserService

' ==========================================
' Relationships: Services Logic
' ==========================================
StgnoService --> F5StegoService
StgnoService --> DSSSStegnoService
StgnoService --> PVDStegoService
StgnoService --> ConvertService
ConvertService *-- OkHttpClient

HistoryService --> FilesRepository
MessageService --> MessageRepository
MessageService --> FilesRepository
UserService --> UserRepository

' ==========================================
' Relationships: Utilities
' ==========================================
DSSSStegnoService --> DsssUtils
PVDStegoService --> PvdUtils
F5StegoService --> F5Utility

' חיבור ישיר יחיד אל תת-התיקייה/ספרייה הסגורה QDCT לצורך אנקפסולציה
F5StegoService --> "QDCT"

' ==========================================
' Relationships: UI to Services & Components
' ==========================================
LoginView --> UserService
RegisterView --> UserService
StgnoView --> StgnoService
InboxView --> MessageService
SentMessagesView --> MessageService
NewMessageDialog --> MessageService
HistoryView --> HistoryService

MainLayout --> HomeView
MainLayout --> StgnoView
MainLayout --> InboxView

InboxView *-- MediaPreviewButton
SentMessagesView *-- MediaPreviewButton
HistoryView *-- MediaPreviewButton

' ==========================================
' Relationships: Repositories to Models
' ==========================================
UserRepository ..> User 
MessageRepository ..> Message 
FilesRepository ..> Files 
Message ..> Files 

@enduml